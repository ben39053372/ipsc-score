{
  "dependencies": {
    "axios": "^1.6.8",
    "jsdom": "^24.0.0",
    "puppeteer": "^22.6.5",
    "puppeteer-page-proxy": "^1.3.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc",
    "main": "npx ts-node src/index.ts",
    "deploy": "gcloud functions deploy getScore --gen2 --region=asia-east2 --runtime=nodejs20 --timeout=500 --memory=4GB --entry-point=getScore --trigger-topic=getScore --max-instances=1",
    "deploy-getAllMatches": "gcloud functions deploy getAllMatches --gen2 --region=asia-east2 --runtime=nodejs20 --timeout=500 --memory=4GB --entry-point=getAllMatches --trigger-http --max-instances=1",
    "gcp-build": "node node_modules/puppeteer/install.mjs && npm run build",
    "start-getAllMatches": "npx functions-framework --target=getAllMatches",
    "start-getScore": "npx functions-framework --target=getScore --signature-type=cloudevent",
    "gcloud-set-project": "gcloud config set project ipsc-score-422008"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6"
  }
}
