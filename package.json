{
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0",
    "axios": "^1.6.8",
    "jsdom": "^24.0.0",
    "puppeteer": "^22.6.5",
    "typescript": "^5.4.5"
  },
  "scripts": {
